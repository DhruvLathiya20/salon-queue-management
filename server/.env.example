# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/salon_queue?retryWrites=true&w=majority

# ─── CORS / Client URL ────────────────────────────────────────────────────────
# Your Vercel frontend URL (no trailing slash)
CLIENT_URL=https://your-app.vercel.app

# ─── Admin PIN ────────────────────────────────────────────────────────────────
# Change this before going live!
ADMIN_PIN=1234
